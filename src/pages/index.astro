---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- TOP NAVIGATION -->
  <header class="sticky top-0 z-50 glass-card border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-violet-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/25">
          <i class="fa-solid fa-radar text-lg animate-pulse"></i>
        </div>
        <div>
          <span class="font-display font-extrabold text-2xl tracking-tight">Prospect<span class="text-blue-600 dark:text-blue-400">AUTO</span></span>
          <span class="block text-[11px] font-medium text-slate-500 dark:text-slate-400 uppercase tracking-widest">Scanner & Hub de Prospection Réel</span>
        </div>
      </div>

      <nav class="hidden md:flex items-center space-x-6 text-sm font-semibold text-slate-600 dark:text-slate-300">
        <a href="#scanner-section" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Scanner de Prospection</a>
        <a href="#prospects-table" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Tous les Établissements</a>
        <a href="#saved-section" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5 text-amber-600 dark:text-amber-400 font-bold">
          <i class="fa-solid fa-bookmark"></i> Enregistrés (<span id="nav-saved-count">0</span>)
        </a>
        <a href="#tracking-section" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Suivi Mails</a>
        <a href="#domaines" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Mes Domaines</a>
      </nav>

      <div class="flex items-center space-x-3">
        <button id="theme-toggle" class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Changer le thème">
          <i class="fa-solid fa-moon dark:hidden text-slate-700"></i>
          <i class="fa-solid fa-sun hidden dark:inline text-amber-400"></i>
        </button>
        <a href="#scanner-section" class="inline-flex items-center px-4 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-600/30 transition-all hover:scale-[1.02]">
          <i class="fa-solid fa-satellite-dish mr-2"></i> Lancer un scan
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">

    <!-- HERO / STATUS BAR -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 p-6 rounded-3xl glass-card">
      <div>
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight">
          Scanner Élargi & Carnet de Prospects Enregistrés
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
          Scannez toutes les crèches (micro-crèches, crèches parentales, haltes), restaurants (brasseries, bistrots, snacks, pizzerias), coiffeurs & barbiers, ou écoles. Mémorisez les meilleurs prospects d'un clic.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-100/80 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Scan Multi-Requêtes Élargi & Téléphone Direct
        </div>
      </div>
    </div>

    <!-- SCANNER SECTION -->
    <section id="scanner-section" class="space-y-6">
      <div class="p-6 rounded-3xl glass-card border border-slate-200 dark:border-slate-800 space-y-6">
        <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
          <div>
            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Paramétrage du scan</span>
            <h2 class="font-display text-2xl font-bold tracking-tight mt-1">Scanner une zone & un secteur d'activité</h2>
          </div>
          <div class="text-xs text-slate-500">
            Recherche globale multi-formats avec géolocalisation
          </div>
        </div>

        <!-- Scan Form Controls -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- 1. Domaine / Catégorie -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
              <i class="fa-solid fa-shapes text-blue-500 mr-1"></i> Domaine d'activité
            </label>
            <select id="scan-domain" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-semibold focus:ring-2 focus:ring-blue-500 outline-none">
              <option value="creche" selected>🍼 Crèches & Micro-Crèches</option>
              <option value="restaurant">🍽️ Restaurants, Brasseries & Snacks</option>
              <option value="barbier">✂️ Coiffeurs & Salons de Barbier</option>
              <option value="ecole">🎓 Écoles & Établissements Privés</option>
            </select>
          </div>

          <!-- 2. Ville de référence / Géoloc -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
              <i class="fa-solid fa-location-dot text-rose-500 mr-1"></i> Ville ou code postal
            </label>
            <div class="relative">
              <input type="text" id="scan-city" value="Marseille" placeholder="ex: Lyon, Bordeaux, 13008..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-medium focus:ring-2 focus:ring-blue-500 outline-none pr-10" />
              <button type="button" id="btn-geoloc" class="absolute right-2 top-2 p-1.5 text-slate-400 hover:text-blue-600 transition-colors" title="Utiliser ma position actuelle (Autour de moi)">
                <i class="fa-solid fa-crosshairs"></i>
              </button>
            </div>
          </div>

          <!-- 3. Rayon kilométrique -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                <i class="fa-solid fa-arrows-to-circle text-amber-500 mr-1"></i> Rayon d'action
              </label>
              <span id="radius-value" class="text-xs font-extrabold text-blue-600 dark:text-blue-400">15 km</span>
            </div>
            <input type="range" id="scan-radius" min="2" max="60" value="15" step="1" class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-600" />
            <div class="flex justify-between text-[10px] text-slate-400 mt-1">
              <span>2 km</span>
              <span>15 km</span>
              <span>30 km</span>
              <span>60 km</span>
            </div>
          </div>

          <!-- 4. Bouton de lancement -->
          <div class="flex items-end">
            <button type="button" id="btn-start-scan" class="w-full py-2.5 px-4 rounded-xl text-sm font-bold bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white shadow-lg shadow-blue-500/25 transition-all flex items-center justify-center gap-2">
              <i class="fa-solid fa-magnifying-glass-location text-base"></i>
              <span id="scan-btn-text">Lancer le scan réel</span>
            </button>
          </div>
        </div>

        <!-- CARTE & RÉSULTATS VISUELS -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 pt-2">
          
          <!-- Carte Leaflet (2 colonnes) -->
          <div class="lg:col-span-2 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 relative shadow-inner bg-slate-100 dark:bg-slate-900 min-h-[420px]">
            <div id="map" class="w-full h-[420px] z-10"></div>
            <div class="absolute top-3 left-14 z-20 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 text-xs font-semibold shadow-sm flex items-center gap-2">
              <i class="fa-solid fa-map-pin text-blue-600"></i>
              <span id="map-status">Prêt pour le scan</span>
            </div>
          </div>

          <!-- Panneau latéral résumé du scan -->
          <div class="p-5 rounded-2xl bg-slate-100/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800">
                <span class="text-xs font-bold uppercase text-slate-500">Bilan du Scan Réel</span>
                <span id="scan-badge-count" class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">0 trouvés</span>
              </div>
              <div class="mt-4 space-y-3 text-xs">
                <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                  <span>Zone ciblée :</span>
                  <strong id="summary-zone" class="text-slate-800 dark:text-slate-200">Marseille</strong>
                </div>
                <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                  <span>Rayon sélectionné :</span>
                  <strong id="summary-radius" class="text-slate-800 dark:text-slate-200">15 km</strong>
                </div>
                <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                  <span>Secteur élargi :</span>
                  <strong id="summary-domain" class="text-slate-800 dark:text-slate-200">Crèches & Micro-Crèches</strong>
                </div>
                <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                  <span>Téléphone détecté :</span>
                  <strong id="summary-phones" class="text-emerald-600 dark:text-emerald-400">0 / 0</strong>
                </div>
                <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                  <span>Sites web répertoriés :</span>
                  <strong id="summary-websites" class="text-blue-600 dark:text-blue-400">0 / 0</strong>
                </div>
              </div>
            </div>

            <!-- Aide contact -->
            <div class="p-3.5 rounded-xl bg-blue-50/80 dark:bg-blue-950/40 border border-blue-200/60 dark:border-blue-900/60 text-[11px] text-blue-900 dark:text-blue-300 space-y-1.5">
              <div class="font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-phone-volume text-blue-600"></i> Appels & Recherche Directe
              </div>
              <p class="leading-relaxed">
                Cliquez directement sur le numéro de téléphone pour appeler l'établissement. S'il n'est pas encore synchronisé, un clic sur <strong>"Google"</strong> ou <strong>"PagesJaunes"</strong> ouvre directement leur fiche locale avec le standard téléphonique à jour.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION DES PROSPECTS ENREGISTRÉS (FAVORIS / BOOKMARKS) -->
    <section id="saved-section" class="space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 p-4 rounded-2xl bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50">
        <div>
          <span class="text-xs font-bold text-amber-700 dark:text-amber-400 uppercase tracking-widest flex items-center gap-1.5">
            <i class="fa-solid fa-bookmark text-amber-500"></i> Mes Prospects Enregistrés
          </span>
          <h2 class="font-display text-xl font-bold tracking-tight mt-0.5">
            Établissements mémorisés pour mon démarchage
          </h2>
        </div>
        <div class="flex items-center gap-2">
          <span id="saved-badge-header" class="text-xs font-bold text-amber-800 dark:text-amber-300 bg-amber-100 dark:bg-amber-900/60 px-3 py-1 rounded-xl">0 enregistré(s)</span>
          <button type="button" id="btn-export-saved-csv" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 border border-amber-300 dark:border-amber-700 hover:bg-amber-50 text-amber-900 dark:text-amber-200 transition-colors">
            <i class="fa-solid fa-file-csv mr-1"></i> Exporter
          </button>
        </div>
      </div>

      <div class="rounded-2xl glass-card border border-amber-200/80 dark:border-amber-900/40 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-amber-100/50 dark:bg-amber-950/50 border-b border-amber-200 dark:border-amber-900/60 font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
              <tr>
                <th class="py-3 px-4">Établissement</th>
                <th class="py-3 px-4">Secteur</th>
                <th class="py-3 px-4">Adresse</th>
                <th class="py-3 px-4">Téléphone / Contact</th>
                <th class="py-3 px-4">Site Web</th>
                <th class="py-3 px-4 text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="saved-tbody" class="divide-y divide-amber-100 dark:divide-slate-800">
              <tr>
                <td colspan="6" class="text-center py-6 text-slate-400">
                  Aucun prospect enregistré. Cliquez sur l'icône <i class="fa-regular fa-bookmark text-amber-500"></i> dans le tableau ci-dessous pour mémoriser un établissement.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- LISTE COMPLÈTE DES ÉTABLISSEMENTS SCANNÉS -->
    <section id="prospects-table" class="space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Résultats Détaillés du Scan</span>
          <h2 class="font-display text-2xl font-bold tracking-tight mt-0.5">
            Tous les Établissements Réels Détectés
          </h2>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" id="btn-export-csv" class="px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center gap-1.5">
            <i class="fa-solid fa-file-csv text-emerald-500"></i> Exporter tous les résultats (CSV)
          </button>
        </div>
      </div>

      <div class="rounded-2xl glass-card border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800 font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider">
              <tr>
                <th class="py-3 px-3 w-10 text-center"><i class="fa-solid fa-bookmark text-amber-500" title="Enregistrer"></i></th>
                <th class="py-3 px-4">Établissement</th>
                <th class="py-3 px-4">Adresse & Ville</th>
                <th class="py-3 px-4">Téléphone</th>
                <th class="py-3 px-4">Email</th>
                <th class="py-3 px-4">Site Web Détecté</th>
                <th class="py-3 px-4 text-center">Action Prospection</th>
              </tr>
            </thead>
            <tbody id="prospects-tbody" class="divide-y divide-slate-200 dark:divide-slate-800">
              <tr>
                <td colspan="7" class="text-center py-10 text-slate-400">
                  <i class="fa-solid fa-satellite-dish text-3xl mb-3 text-slate-300 dark:text-slate-700 block animate-bounce"></i>
                  Chargement des établissements réels en cours...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- LISTE DE SUIVI DES MAILS ENVOYÉS -->
    <section id="tracking-section" class="space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">Historique & CRM Léger</span>
          <h2 class="font-display text-2xl font-bold tracking-tight mt-0.5">
            Suivi des Mails Envoyés & Statuts
          </h2>
        </div>
        <button type="button" id="btn-clear-tracking" class="text-xs text-rose-500 hover:underline">
          Effacer l'historique de suivi
        </button>
      </div>

      <div class="rounded-2xl glass-card border border-slate-200 dark:border-slate-800 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800 font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider">
              <tr>
                <th class="py-3 px-4">Date & Heure</th>
                <th class="py-3 px-4">Destinataire</th>
                <th class="py-3 px-4">Secteur</th>
                <th class="py-3 px-4">Objet</th>
                <th class="py-3 px-4">Statut</th>
                <th class="py-3 px-4 text-center">Action</th>
              </tr>
            </thead>
            <tbody id="tracking-tbody" class="divide-y divide-slate-200 dark:divide-slate-800">
              <tr>
                <td colspan="6" class="text-center py-8 text-slate-400">
                  Aucun email envoyé pour le moment.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- MES DOMAINES D'ACTIVITÉ (RAPPEL DES EXPERTISES) -->
    <section id="domaines" class="py-8 border-t border-slate-200 dark:border-slate-800 space-y-6">
      <div>
        <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Offre & Valeur Ajoutée</span>
        <h2 class="font-display text-2xl font-bold tracking-tight mt-1">
          Les 4 Spécialités Métiers de mes Sites Web
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- 1. Micro-Crèches -->
        <div class="p-5 rounded-2xl glass-card border border-emerald-300/40 dark:border-emerald-800/40 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-600 flex items-center justify-center text-lg font-bold">
            🍼
          </div>
          <h3 class="font-bold text-base">Crèches & Micro-Crèches</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Formulaire de pré-inscription complet, présentation de la journée type, équipe, projet pédagogique et respect du cahier des charges PMI.
          </p>
        </div>

        <!-- 2. Restaurants -->
        <div class="p-5 rounded-2xl glass-card border border-orange-300/40 dark:border-orange-800/40 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-orange-100 dark:bg-orange-950 text-orange-600 flex items-center justify-center text-lg font-bold">
            🍽️
          </div>
          <h3 class="font-bold text-base">Restaurants, Brasseries & Snacks</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Remplacement des cartes PDF illisibles par un menu mobile instantané et système de réservation de couverts direct sans commission.
          </p>
        </div>

        <!-- 3. Coiffeurs Barbiers -->
        <div class="p-5 rounded-2xl glass-card border border-amber-300/40 dark:border-amber-800/40 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950 text-amber-600 flex items-center justify-center text-lg font-bold">
            ✂️
          </div>
          <h3 class="font-bold text-base">Coiffeurs & Salons de Barbier</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Grille tarifaire claire, galerie de coiffures/grooming et bouton d'action vers la réservation immédiate (Planity, direct).
          </p>
        </div>

        <!-- 4. Petites Écoles -->
        <div class="p-5 rounded-2xl glass-card border border-purple-300/40 dark:border-purple-800/40 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-950 text-purple-600 flex items-center justify-center text-lg font-bold">
            🎓
          </div>
          <h3 class="font-bold text-base">Petites Écoles & Établissements Privés</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Dossier d'admission en ligne, calendrier des événements et journées portes ouvertes, valorisation du projet éducatif alternatif.
          </p>
        </div>
      </div>
    </section>

  </main>

  <!-- MODAL DE CONFIRMATION / PRÉPARATION D'EMAIL -->
  <div id="email-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-6 relative max-h-[90vh] overflow-y-auto">
      
      <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 flex items-center justify-center text-lg font-bold">
            <i class="fa-solid fa-paper-plane"></i>
          </div>
          <div>
            <h3 class="font-display text-lg font-bold">Validation de l'Email Prospect</h3>
            <p class="text-xs text-slate-500">Contrôle de validation avant envoi</p>
          </div>
        </div>
        <button type="button" id="btn-close-modal" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">Destinataire</label>
          <input type="text" id="modal-recipient" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-semibold" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">Objet de l'email</label>
          <input type="text" id="modal-subject" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-semibold" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">Contenu personnalisé par l'IA</label>
          <textarea id="modal-body" rows="9" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-mono text-xs leading-relaxed focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60 text-[11px] text-amber-900 dark:text-amber-200 flex items-center gap-2">
        <i class="fa-solid fa-circle-exclamation text-amber-500 text-sm"></i>
        <span>Envoi sécurisé : vous pouvez ouvrir directement le brouillon dans votre messagerie Gmail ou marquer comme envoyé dans le suivi.</span>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-2">
        <button type="button" id="btn-cancel-modal" class="w-full sm:w-auto px-4 py-2.5 rounded-xl font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 transition-colors text-xs">
          Annuler
        </button>
        <button type="button" id="btn-open-gmail" class="w-full sm:w-auto px-4 py-2.5 rounded-xl font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-md text-xs flex items-center justify-center gap-2">
          <i class="fa-solid fa-envelope"></i> Ouvrir dans Gmail
        </button>
        <button type="button" id="btn-confirm-sent" class="w-full sm:w-auto px-4 py-2.5 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md text-xs flex items-center justify-center gap-2">
          <i class="fa-solid fa-check"></i> Enregistrer dans le suivi
        </button>
      </div>

    </div>
  </div>

  <!-- FOOTER -->
  <footer class="py-8 border-t border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 space-y-2">
      <p class="font-display font-bold text-slate-700 dark:text-slate-300">ProspectAUTO &copy; 2026 - Plateforme de Prospection & Solutions Web Métier</p>
      <p>Micro-Crèches & Crèches • Restaurants & Snacks • Coiffeurs & Barbiers • Petites Écoles</p>
    </div>
  </footer>

  <!-- SCRIPT LOGIQUE PROSPECTION -->
  <script>
    declare const L: any;

    interface Prospect {
      id: string;
      name: string;
      domain: string;
      domainLabel: string;
      address: string;
      city: string;
      phone: string;
      email: string;
      website: string;
      lat: number;
      lng: number;
      distanceKm?: number;
    }

    interface TrackingItem {
      id: string;
      timestamp: string;
      name: string;
      email: string;
      domainLabel: string;
      subject: string;
      status: 'Approuvé' | 'Envoyé' | 'Relancé';
    }

    // State
    let map: any = null;
    let markersLayer: any = null;
    let radiusCircle: any = null;
    let currentCenter = { lat: 43.2965, lng: 5.3698, city: 'Marseille', depcode: '13' };
    let currentRadiusKm = 15;
    let currentDomain = 'creche';
    let currentProspects: Prospect[] = [];
    let selectedProspectForEmail: Prospect | null = null;

    // Local Storage: Saved Bookmarks
    const SAVED_KEY = 'prospectauto_saved_leads';
    function getSaved(): Prospect[] {
      try {
        const data = localStorage.getItem(SAVED_KEY);
        return data ? JSON.parse(data) : [];
      } catch {
        return [];
      }
    }
    function saveSaved(list: Prospect[]) {
      localStorage.setItem(SAVED_KEY, JSON.stringify(list));
      renderSavedTable();
      renderProspectsTable();
    }
    function isProspectSaved(id: string): boolean {
      return getSaved().some(p => p.id === id);
    }
    (window as any).toggleSaveProspect = function(id: string) {
      const savedList = getSaved();
      const existingIdx = savedList.findIndex(p => p.id === id);
      if (existingIdx >= 0) {
        savedList.splice(existingIdx, 1);
      } else {
        const p = currentProspects.find(item => item.id === id);
        if (p) savedList.unshift(p);
      }
      saveSaved(savedList);
    };

    // Local Storage: Email Tracking
    const TRACKING_KEY = 'prospectauto_tracking';
    function getTracking(): TrackingItem[] {
      try {
        const data = localStorage.getItem(TRACKING_KEY);
        return data ? JSON.parse(data) : [];
      } catch {
        return [];
      }
    }
    function saveTracking(items: TrackingItem[]) {
      localStorage.setItem(TRACKING_KEY, JSON.stringify(items));
      renderTrackingTable();
    }

    // Email Templates
    const emailTemplates: Record<string, { subject: string; body: (p: Prospect) => string }> = {
      creche: {
        subject: "Modernisation des inscriptions & vitrine pédagogique",
        body: (p) => `Bonjour ${p.name},\n\nJe vous contacte car j'accompagne spécifiquement les crèches et structures petite enfance dans la mise en avant de leur projet pédagogique et la gestion simplifiée de leurs admissions.\n\nEn découvrant votre structure à ${p.city}, j'ai constaté l'importance que vous accordez à l'accueil et au bien-être des tout-petits. Pour d'autres gestionnaires de crèches, nous avons conçu un portail clé-en-main comprenant un formulaire de pré-inscription complet (normes CAF/PMI), un aperçu de la journée type et une vitrine sécurisée pour rassurer les familles.\n\nSeriez-vous ouvert(e) à échanger 5 minutes cette semaine par téléphone ?\n\nBien cordialement,\nAlexandre Poveda\n06 00 00 00 00`
      },
      restaurant: {
        subject: "Remplacement du menu PDF & réservations sans commission",
        body: (p) => `Bonjour l'équipe de ${p.name},\n\nJe suis tombé sur votre établissement à ${p.city} et vos spécialités font très envie !\n\nToutefois, la majorité des clients sur smartphone fuient les menus en fichiers PDF difficiles à zoomer ou passent par des plateformes qui prélèvent des commissions importantes sur chaque couvert.\n\nNous concevons pour les restaurateurs des sites fluides avec un menu digital interactif instantané et un module de réservation direct sans intermédiaire.\n\nAuriez-vous 5 minutes pour y jeter un coup d'œil lors d'un appel rapide ?\n\nBien cordialement,\nAlexandre Poveda`
      },
      barbier: {
        subject: "Visibilité locale Google Maps & rendez-vous en ligne",
        body: (p) => `Bonjour ${p.name},\n\nJe vous écris après avoir découvert votre salon à ${p.city}. L'univers et le savoir-faire que vous proposez sont remarquables.\n\nPour les salons de coiffure et barbiers indépendants, nous déployons des sites au design soigné intégrant immédiatement la grille de prestations et la redirection directe vers la prise de créneau en ligne pour capter les clients locaux sur Google.\n\nPouvons-nous en discuter 5 minutes cette semaine ?\n\nBien cordialement,\nAlexandre Poveda`
      },
      ecole: {
        subject: "Portail d'admission & valorisation pédagogique",
        body: (p) => `Bonjour Madame, Monsieur la Direction de ${p.name},\n\nJe prends contact avec vous car nous accompagnons les petites écoles indépendantes et structures d'enseignement alternatif dans la digitalisation de leur accueil.\n\nNous mettons en place un portail dédié regroupant le calendrier scolaire, le projet éducatif et un formulaire complet de demande d'admission pour faciliter vos rentrées et renseigner clairement les parents d'élèves.\n\nSeriez-vous disponible pour un court échange téléphonique ?\n\nBien cordialement,\nAlexandre Poveda`
      }
    };

    // Calculate approximate distance
    function calculateDistanceKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = 
        Math.sin(dLat/2) * Math.sin(dLat/2) +
        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
        Math.sin(dLon/2) * Math.sin(dLon/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return Math.round(R * c * 10) / 10;
    }

    // Init Leaflet Map
    function initMap() {
      if (typeof L === 'undefined') return;
      const mapContainer = document.getElementById('map');
      if (!mapContainer) return;

      map = L.map('map').setView([currentCenter.lat, currentCenter.lng], 12);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      markersLayer = L.layerGroup().addTo(map);
      updateRadiusCircle();
    }

    function updateRadiusCircle() {
      if (!map) return;
      if (radiusCircle) map.removeLayer(radiusCircle);

      radiusCircle = L.circle([currentCenter.lat, currentCenter.lng], {
        color: '#2563eb',
        fillColor: '#3b82f6',
        fillOpacity: 0.12,
        weight: 2,
        radius: currentRadiusKm * 1000
      }).addTo(map);

      map.fitBounds(radiusCircle.getBounds(), { padding: [20, 20] });
    }

    // MULTI-QUERY REAL SCAN ENGINE
    async function performScan() {
      const scanBtnText = document.getElementById('scan-btn-text');
      const mapStatus = document.getElementById('map-status');
      if (scanBtnText) scanBtnText.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Scan multi-catégories...';
      if (mapStatus) mapStatus.textContent = 'Interrogation des registres et POIs...';

      // 1. Geocode City
      const cityInput = (document.getElementById('scan-city') as HTMLInputElement)?.value.trim() || 'Marseille';
      try {
        const geoRes = await fetch(`https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(cityInput)}&limit=1`);
        const geoData = await geoRes.json();
        if (geoData?.features?.length > 0) {
          const coords = geoData.features[0].geometry.coordinates;
          const props = geoData.features[0].properties;
          currentCenter = {
            lng: coords[0],
            lat: coords[1],
            city: props.city || props.name || cityInput,
            depcode: props.depcode || props.postcode?.slice(0, 2) || '13'
          };
          updateRadiusCircle();
        }
      } catch (err) {
        console.warn('Geocoding notice:', err);
      }

      // Update Summary UI
      const domainSelect = document.getElementById('scan-domain') as HTMLSelectElement;
      currentDomain = domainSelect?.value || 'creche';
      
      const domainLabels: Record<string, string> = {
        creche: 'Crèches & Micro-Crèches',
        restaurant: 'Restaurants, Brasseries & Snacks',
        barbier: 'Coiffeurs & Salons de Barbier',
        ecole: 'Petites Écoles'
      };

      const sumZone = document.getElementById('summary-zone');
      const sumRadius = document.getElementById('summary-radius');
      const sumDomain = document.getElementById('summary-domain');
      if (sumZone) sumZone.textContent = currentCenter.city;
      if (sumRadius) sumRadius.textContent = `${currentRadiusKm} km`;
      if (sumDomain) sumDomain.textContent = domainLabels[currentDomain] || currentDomain;

      let foundItems: Prospect[] = [];

      // 2. Broad Multi-Query Sets (Broaden searches for real places)
      const multiQueries: Record<string, string[]> = {
        creche: [
          `Micro-crèche ${currentCenter.city}`,
          `crèche ${currentCenter.city}`,
          `halte garderie ${currentCenter.city}`,
          `garde enfants ${currentCenter.city}`
        ],
        restaurant: [
          `restaurant ${currentCenter.city}`,
          `brasserie ${currentCenter.city}`,
          `snack ${currentCenter.city}`,
          `pizzeria ${currentCenter.city}`
        ],
        barbier: [
          `barbier ${currentCenter.city}`,
          `coiffeur ${currentCenter.city}`,
          `salon de coiffure ${currentCenter.city}`
        ],
        ecole: [
          `école privée ${currentCenter.city}`,
          `école montessori ${currentCenter.city}`,
          `école maternelle ${currentCenter.city}`
        ]
      };

      const queries = multiQueries[currentDomain] || multiQueries.creche;

      // Query OpenStreetMap via Nominatim with valid User-Agent
      for (const q of queries) {
        try {
          const osmUrl = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&limit=15&addressdetails=1&extratags=1&countrycodes=fr`;
          const osmRes = await fetch(osmUrl, {
            headers: { 'User-Agent': 'ProspectAUTO-Commercial/1.0 (contact@prospectauto.fr)' }
          });
          const osmData = await osmRes.json();

          if (Array.isArray(osmData)) {
            osmData.forEach((item: any) => {
              // Exclude street or cliff names like "Rue de la crèche"
              if (item.class === 'highway' || item.class === 'natural' || item.class === 'boundary') return;

              const lat = parseFloat(item.lat);
              const lon = parseFloat(item.lon);
              const dist = calculateDistanceKm(currentCenter.lat, currentCenter.lng, lat, lon);

              const addr = item.address || {};
              const road = addr.road || addr.quarter || addr.suburb || '';
              const houseNum = addr.house_number ? `${addr.house_number}, ` : '';
              const fullAddress = `${houseNum}${road}`.trim() || item.display_name.split(',')[0];
              const city = addr.city || addr.town || addr.village || addr.municipality || currentCenter.city;

              const extra = item.extratags || {};
              const rawPhone = extra.phone || extra['contact:phone'] || '';
              const rawEmail = extra.email || extra['contact:email'] || '';
              const rawWebsite = extra.website || extra['contact:website'] || '';

              const rawName = item.name || item.display_name.split(',')[0];
              const cleanName = rawName.replace(/^amenity:|^shop:/i, '').trim();

              if (cleanName && cleanName.length > 2) {
                const isDuplicate = foundItems.some(i => i.name.toLowerCase() === cleanName.toLowerCase() || (Math.abs(i.lat - lat) < 0.0008 && Math.abs(i.lng - lon) < 0.0008));
                if (!isDuplicate) {
                  foundItems.push({
                    id: `osm-${item.osm_id || Math.random()}`,
                    name: cleanName,
                    domain: currentDomain,
                    domainLabel: domainLabels[currentDomain],
                    address: fullAddress,
                    city,
                    phone: rawPhone,
                    email: rawEmail,
                    website: rawWebsite,
                    lat,
                    lng: lon,
                    distanceKm: dist
                  });
                }
              }
            });
          }
        } catch (err) {
          console.warn('Query warning for', q, err);
        }
      }

      // Filter by radius & sort
      currentProspects = foundItems.filter(p => (p.distanceKm || 0) <= currentRadiusKm + 3);
      currentProspects.sort((a, b) => (a.distanceKm || 0) - (b.distanceKm || 0));

      // Render
      renderMapMarkers();
      renderProspectsTable();
      renderSavedTable();

      // Update counters
      const scanBadge = document.getElementById('scan-badge-count');
      const sumPhones = document.getElementById('summary-phones');
      const sumWebsites = document.getElementById('summary-websites');
      const countWithPhone = currentProspects.filter(p => p.phone && p.phone.length > 3).length;
      const countWithWeb = currentProspects.filter(p => p.website && p.website.startsWith('http')).length;

      if (scanBadge) scanBadge.textContent = `${currentProspects.length} trouvés`;
      if (sumPhones) sumPhones.textContent = `${countWithPhone} / ${currentProspects.length}`;
      if (sumWebsites) sumWebsites.textContent = `${countWithWeb} / ${currentProspects.length}`;

      if (scanBtnText) scanBtnText.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Relancer le scan';
      if (mapStatus) mapStatus.textContent = `${currentProspects.length} ${domainLabels[currentDomain]} réelles scannées`;
    }

    // Helper: Google Search Link generator
    function getGoogleSearchUrl(name: string, city: string): string {
      return `https://www.google.com/search?q=${encodeURIComponent(name + ' ' + city + ' telephone')}`;
    }

    // Helper: PagesJaunes Link generator
    function getPagesJaunesUrl(name: string, city: string): string {
      return `https://www.pagesjaunes.fr/annuaire/chercherlespros?quoiqui=${encodeURIComponent(name)}&ou=${encodeURIComponent(city)}`;
    }

    // Render Markers on Map
    function renderMapMarkers() {
      if (!markersLayer) return;
      markersLayer.clearLayers();

      currentProspects.forEach(p => {
        const marker = L.marker([p.lat, p.lng]).addTo(markersLayer);
        const phoneHtml = p.phone 
          ? `<a href="tel:${p.phone.replace(/\s+/g, '')}" class="text-emerald-600 font-bold hover:underline">📞 ${p.phone}</a>`
          : `<a href="${getGoogleSearchUrl(p.name, p.city)}" target="_blank" rel="noopener" class="text-blue-600 text-[11px] underline">Trouver numéro sur Google</a>`;

        const webHtml = p.website && p.website.startsWith('http')
          ? `<a href="${p.website}" target="_blank" rel="noopener" class="text-blue-600 underline font-semibold">Site officiel</a>`
          : `<span class="text-amber-600 font-bold">Sans site officiel (À créer)</span>`;

        marker.bindPopup(`
          <div class="text-xs p-1 space-y-1.5 font-sans">
            <strong class="text-sm font-bold text-slate-900 block">${p.name}</strong>
            <p class="text-slate-600 m-0">${p.address}, ${p.city} (${p.distanceKm} km)</p>
            <p class="m-0">${phoneHtml}</p>
            <p class="m-0">${webHtml}</p>
            <div class="flex gap-1 pt-1">
              <button onclick="window.prepareEmail('${p.id}')" class="flex-1 py-1.5 px-2 bg-blue-600 text-white rounded font-bold hover:bg-blue-700 transition">
                Préparer mail
              </button>
              <button onclick="window.toggleSaveProspect('${p.id}')" class="py-1.5 px-2 bg-amber-500 text-white rounded font-bold hover:bg-amber-600 transition" title="Enregistrer">
                <i class="fa-solid fa-bookmark"></i>
              </button>
            </div>
          </div>
        `);
      });
    }

    // Render Prospects Table
    function renderProspectsTable() {
      const tbody = document.getElementById('prospects-tbody');
      if (!tbody) return;

      if (currentProspects.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="text-center py-8 text-slate-400">
              Aucun établissement trouvé dans ce rayon de ${currentRadiusKm} km. Essayez d'augmenter le curseur de distance ou de modifier la ville.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = currentProspects.map(p => {
        const saved = isProspectSaved(p.id);
        const bookmarkBtn = `
          <button onclick="window.toggleSaveProspect('${p.id}')" class="p-1.5 rounded-lg text-sm transition-colors ${saved ? 'text-amber-500 hover:text-amber-600' : 'text-slate-300 dark:text-slate-600 hover:text-amber-500'}" title="${saved ? 'Retirer des enregistrés' : 'Enregistrer ce prospect'}">
            <i class="${saved ? 'fa-solid' : 'fa-regular'} fa-bookmark"></i>
          </button>
        `;

        // Phone column
        const phoneCell = p.phone
          ? `<a href="tel:${p.phone.replace(/\s+/g, '')}" class="inline-flex items-center gap-1 font-mono font-bold text-emerald-600 dark:text-emerald-400 hover:underline"><i class="fa-solid fa-phone text-[10px]"></i> ${p.phone}</a>`
          : `
            <div class="flex items-center gap-1 text-[11px]">
              <a href="${getGoogleSearchUrl(p.name, p.city)}" target="_blank" rel="noopener" class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1" title="Chercher le numéro sur Google">
                <i class="fa-brands fa-google text-[10px]"></i> Google
              </a>
              <a href="${getPagesJaunesUrl(p.name, p.city)}" target="_blank" rel="noopener" class="px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 hover:underline inline-flex items-center gap-1" title="Chercher sur PagesJaunes">
                PJ
              </a>
            </div>
          `;

        // Email column
        const emailCell = p.email
          ? `<a href="mailto:${p.email}" class="text-blue-600 dark:text-blue-400 hover:underline">${p.email}</a>`
          : `<span class="text-slate-400 italic">Non renseigné</span>`;

        // Website column
        const hasWeb = p.website && p.website.startsWith('http');
        const webCell = hasWeb 
          ? `<a href="${p.website}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:underline"><i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> ${p.website.replace(/^https?:\/\/(www\.)?/, '').slice(0, 18)}...</a>`
          : `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300">À créer</span>`;

        return `
          <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
            <td class="py-3 px-3 text-center">${bookmarkBtn}</td>
            <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">
              <div class="flex items-center gap-2">
                <span>${p.name}</span>
                <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 font-normal">${p.distanceKm} km</span>
              </div>
            </td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">${p.address}, ${p.city}</td>
            <td class="py-3 px-4">${phoneCell}</td>
            <td class="py-3 px-4">${emailCell}</td>
            <td class="py-3 px-4">${webCell}</td>
            <td class="py-3 px-4 text-center">
              <button onclick="window.prepareEmail('${p.id}')" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-sm transition-all hover:scale-105 inline-flex items-center gap-1.5">
                <i class="fa-solid fa-envelope"></i> Contacter
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Render Saved Table (Bookmarks)
    function renderSavedTable() {
      const tbody = document.getElementById('saved-tbody');
      const badgeHeader = document.getElementById('saved-badge-header');
      const navSavedCount = document.getElementById('nav-saved-count');
      const savedList = getSaved();

      if (badgeHeader) badgeHeader.textContent = `${savedList.length} enregistré(s)`;
      if (navSavedCount) navSavedCount.textContent = savedList.length.toString();
      if (!tbody) return;

      if (savedList.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center py-6 text-slate-400">
              Aucun prospect enregistré. Cliquez sur l'icône <i class="fa-regular fa-bookmark text-amber-500"></i> dans le tableau pour mémoriser vos cibles prioritaires.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = savedList.map(p => {
        const phoneCell = p.phone
          ? `<a href="tel:${p.phone.replace(/\s+/g, '')}" class="font-mono font-bold text-emerald-600 hover:underline">📞 ${p.phone}</a>`
          : `<a href="${getGoogleSearchUrl(p.name, p.city)}" target="_blank" rel="noopener" class="text-blue-600 text-[11px] underline">Numéro sur Google</a>`;

        const webCell = p.website && p.website.startsWith('http')
          ? `<a href="${p.website}" target="_blank" rel="noopener" class="text-blue-600 underline">Voir site</a>`
          : `<span class="text-amber-600 font-bold">Sans site</span>`;

        return `
          <tr class="hover:bg-amber-50/50 dark:hover:bg-slate-800/40 transition-colors">
            <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">${p.name}</td>
            <td class="py-3 px-4 text-slate-500">${p.domainLabel}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">${p.address}, ${p.city}</td>
            <td class="py-3 px-4">${phoneCell}</td>
            <td class="py-3 px-4">${webCell}</td>
            <td class="py-3 px-4 text-center space-x-2">
              <button onclick="window.prepareEmail('${p.id}')" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-600 text-white hover:bg-blue-700">
                Mail
              </button>
              <button onclick="window.toggleSaveProspect('${p.id}')" class="px-2.5 py-1 rounded-lg text-xs text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40">
                Retirer
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Render Tracking Table
    function renderTrackingTable() {
      const tbody = document.getElementById('tracking-tbody');
      if (!tbody) return;
      const list = getTracking();

      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center py-8 text-slate-400">
              Aucun email dans la liste de suivi. Préparez un email et confirmez l'envoi pour l'ajouter ici.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = list.map(item => `
        <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
          <td class="py-3 px-4 text-slate-500">${item.timestamp}</td>
          <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">${item.name} (${item.email})</td>
          <td class="py-3 px-4">${item.domainLabel}</td>
          <td class="py-3 px-4 text-slate-600 dark:text-slate-300 truncate max-w-xs">${item.subject}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">
              ${item.status}
            </span>
          </td>
          <td class="py-3 px-4 text-center">
            <button onclick="window.toggleStatus('${item.id}')" class="text-xs text-blue-600 hover:underline">
              Changer statut
            </button>
          </td>
        </tr>
      `).join('');
    }

    // Modal Email Preparation
    const emailModal = document.getElementById('email-modal');
    const modalRecipient = document.getElementById('modal-recipient') as HTMLInputElement;
    const modalSubject = document.getElementById('modal-subject') as HTMLInputElement;
    const modalBody = document.getElementById('modal-body') as HTMLTextAreaElement;

    (window as any).prepareEmail = function(prospectId: string) {
      let p = currentProspects.find(item => item.id === prospectId);
      if (!p) p = getSaved().find(item => item.id === prospectId);
      if (!p) return;

      selectedProspectForEmail = p;
      const template = emailTemplates[p.domain] || emailTemplates.creche;
      
      const emailValue = p.email && p.email.includes('@') ? p.email : '';
      if (modalRecipient) modalRecipient.value = emailValue ? `${p.name} <${emailValue}>` : p.name;
      if (modalSubject) modalSubject.value = `${template.subject} - ${p.name}`;
      if (modalBody) modalBody.value = template.body(p);

      if (emailModal) emailModal.classList.remove('hidden');
    };

    (window as any).toggleStatus = function(trackingId: string) {
      const list = getTracking();
      const target = list.find(i => i.id === trackingId);
      if (target) {
        target.status = target.status === 'Approuvé' ? 'Envoyé' : (target.status === 'Envoyé' ? 'Relancé' : 'Approuvé');
        saveTracking(list);
      }
    };

    // Close Modal
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnCancelModal = document.getElementById('btn-cancel-modal');
    if (btnCloseModal) btnCloseModal.addEventListener('click', () => emailModal?.classList.add('hidden'));
    if (btnCancelModal) btnCancelModal.addEventListener('click', () => emailModal?.classList.add('hidden'));

    // Open in Gmail
    const btnOpenGmail = document.getElementById('btn-open-gmail');
    if (btnOpenGmail) {
      btnOpenGmail.addEventListener('click', () => {
        if (!selectedProspectForEmail) return;
        const to = selectedProspectForEmail.email && selectedProspectForEmail.email.includes('@') ? selectedProspectForEmail.email : '';
        const subj = encodeURIComponent(modalSubject.value);
        const body = encodeURIComponent(modalBody.value);
        const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${to}&su=${subj}&body=${body}`;
        window.open(gmailUrl, '_blank');
      });
    }

    // Confirm & Save to Tracking
    const btnConfirmSent = document.getElementById('btn-confirm-sent');
    if (btnConfirmSent) {
      btnConfirmSent.addEventListener('click', () => {
        if (!selectedProspectForEmail) return;
        const list = getTracking();
        const dateStr = new Date().toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' });

        list.unshift({
          id: 'track-' + Date.now(),
          timestamp: dateStr,
          name: selectedProspectForEmail.name,
          email: selectedProspectForEmail.email || 'Via Téléphone / Direct',
          domainLabel: selectedProspectForEmail.domainLabel,
          subject: modalSubject.value,
          status: 'Envoyé'
        });

        saveTracking(list);
        emailModal?.classList.add('hidden');
      });
    }

    // Radius Slider Event
    const radiusSlider = document.getElementById('scan-radius') as HTMLInputElement;
    const radiusValue = document.getElementById('radius-value');
    if (radiusSlider && radiusValue) {
      radiusSlider.addEventListener('input', () => {
        currentRadiusKm = parseInt(radiusSlider.value, 10);
        radiusValue.textContent = `${currentRadiusKm} km`;
        updateRadiusCircle();
      });
    }

    // Geolocation "Autour de moi"
    const btnGeoloc = document.getElementById('btn-geoloc');
    if (btnGeoloc) {
      btnGeoloc.addEventListener('click', () => {
        if (!navigator.geolocation) {
          alert("La géolocalisation n'est pas supportée par votre navigateur.");
          return;
        }
        btnGeoloc.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        navigator.geolocation.getCurrentPosition(async (pos) => {
          currentCenter.lat = pos.coords.latitude;
          currentCenter.lng = pos.coords.longitude;
          try {
            const revRes = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${currentCenter.lat}&lon=${currentCenter.lng}&format=json`, {
              headers: { 'User-Agent': 'ProspectAUTO-Commercial/1.0 (contact@prospectauto.fr)' }
            });
            const revData = await revRes.json();
            const cityName = revData.address?.city || revData.address?.town || revData.address?.village || 'Autour de moi';
            currentCenter.city = cityName;
            const cityInput = document.getElementById('scan-city') as HTMLInputElement;
            if (cityInput) cityInput.value = cityName;
          } catch {
            currentCenter.city = 'Position actuelle';
          }
          btnGeoloc.innerHTML = '<i class="fa-solid fa-crosshairs"></i>';
          updateRadiusCircle();
          performScan();
        }, () => {
          alert("Impossible de récupérer votre position.");
          btnGeoloc.innerHTML = '<i class="fa-solid fa-crosshairs"></i>';
        });
      });
    }

    // CSV Exports
    function exportToCsv(items: Prospect[], filename: string) {
      const headers = ["Nom", "Domaine", "Adresse", "Ville", "Distance (km)", "Téléphone", "Email", "Site Web"];
      const rows = items.map(p => [
        `"${p.name.replace(/"/g, '""')}"`,
        `"${p.domainLabel}"`,
        `"${p.address.replace(/"/g, '""')}"`,
        `"${p.city}"`,
        p.distanceKm || '',
        `"${p.phone || ''}"`,
        `"${p.email || ''}"`,
        `"${p.website || ''}"`
      ]);

      const csvContent = "data:text/csv;charset=utf-8,\uFEFF" + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", filename);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    const btnExportCsv = document.getElementById('btn-export-csv');
    if (btnExportCsv) {
      btnExportCsv.addEventListener('click', () => {
        if (currentProspects.length === 0) {
          alert("Veuillez d'abord lancer un scan.");
          return;
        }
        exportToCsv(currentProspects, `prospects_${currentDomain}_${currentCenter.city.replace(/\s+/g, '_')}.csv`);
      });
    }

    const btnExportSavedCsv = document.getElementById('btn-export-saved-csv');
    if (btnExportSavedCsv) {
      btnExportSavedCsv.addEventListener('click', () => {
        const saved = getSaved();
        if (saved.length === 0) {
          alert("Aucun prospect enregistré.");
          return;
        }
        exportToCsv(saved, `prospects_enregistres_${currentCenter.city.replace(/\s+/g, '_')}.csv`);
      });
    }

    // Clear Tracking
    const btnClearTracking = document.getElementById('btn-clear-tracking');
    if (btnClearTracking) {
      btnClearTracking.addEventListener('click', () => {
        if (confirm("Voulez-vous réinitialiser l'historique des emails suivis ?")) {
          saveTracking([]);
        }
      });
    }

    // Theme Toggle
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
      });
    }

    // Start Scan Button
    const btnStartScan = document.getElementById('btn-start-scan');
    if (btnStartScan) {
      btnStartScan.addEventListener('click', () => {
        performScan();
      });
    }

    // Initial Load
    window.addEventListener('DOMContentLoaded', () => {
      initMap();
      renderSavedTable();
      renderTrackingTable();
      performScan();
    });
  </script>
</Layout>
